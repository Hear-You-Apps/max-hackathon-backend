{
  "name": "max-hackathon-backend",
  "version": "0.0.1",
  "description": "Max Hackathon API",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "prepare": "husky",
    "build": "prisma generate && nest build",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write src prisma.config.ts",
    "format:check": "prettier --check src prisma.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "@prisma/adapter-mariadb": { "mariadb": "^3.5.4" },
    "@prisma/config": { "deepmerge-ts": "^8.0.2" },
    "mysql2": "^3.24.4"
  }
}
