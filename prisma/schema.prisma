generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  maxId     BigInt  @unique @map("max_id")
  firstName String  @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)
  username  String? @db.VarChar(255)
  photoUrl  String? @map("photo_url") @db.Text

  houseMemberships      HouseMembership[]
  houseJoinRequests     HouseJoinRequest[]
  meetings              Meeting[]
  meetingVotes          MeetingVote[]
  meetingParticipations MeetingParticipation[]

  @@map("users")
}

enum HouseMembershipStatus {
  approved
  revoked
  left
}

enum HouseRole {
  resident
  organizer
  house_council
  house_admin
}

enum ApartmentRelationship {
  owner
  tenant
}

enum ApartmentVerificationStatus {
  pending
  verified
  rejected
}

enum HouseJoinRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum HouseContactType {
  dispatcher
  emergency
  plumber
  electrician
  representative
  passport_office
  other
}

enum HouseEventType {
  water_outage
  power_outage
  cleaning
  maintenance
  other
}

enum HouseChatType {
  chat
  channel
}

enum MeetingFormat {
  in_person
  absentee
  mixed
}

enum MeetingVoteChoice {
  yes
  no
  abstain
}

model House {
  id                    Int     @id @default(autoincrement()) @db.UnsignedInt
  address               String  @db.VarChar(500)
  managementCompanyName String? @map("management_company_name") @db.VarChar(255)
  adminContactUrl       String? @map("admin_contact_url") @db.VarChar(2048)
  apartmentsCount       Int?    @map("apartments_count") @db.UnsignedInt
  entrancesCount        Int?    @map("entrances_count") @db.UnsignedInt
  yearBuilt             Int?    @map("year_built") @db.UnsignedSmallInt
  paymentUrl            String? @map("payment_url") @db.VarChar(2048)

  memberships  HouseMembership[]
  apartments   Apartment[]
  joinRequests HouseJoinRequest[]
  invitations  HouseInvitation[]
  contacts     HouseContact[]
  events       HouseEvent[]
  chats        HouseChat[]
  meetings     Meeting[]

  @@map("houses")
}

model HouseChat {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  houseId     Int           @map("house_id") @db.UnsignedInt
  type        HouseChatType
  name        String        @db.VarChar(255)
  description String?       @db.Text
  url         String        @db.VarChar(2048)
  sortOrder   Int           @default(0) @map("sort_order") @db.UnsignedInt

  house House @relation(fields: [houseId], references: [id])

  @@index([houseId, sortOrder, id])
  @@map("house_chats")
}

model HouseContact {
  id           Int              @id @default(autoincrement()) @db.UnsignedInt
  houseId      Int              @map("house_id") @db.UnsignedInt
  type         HouseContactType @default(other)
  name         String           @db.VarChar(255)
  phone        String?          @db.VarChar(64)
  address      String?          @db.VarChar(500)
  workingHours String?          @map("working_hours") @db.VarChar(255)
  messengerUrl String?          @map("messenger_url") @db.VarChar(2048)
  sortOrder    Int              @default(0) @map("sort_order") @db.UnsignedInt

  house House @relation(fields: [houseId], references: [id])

  @@index([houseId, sortOrder, id])
  @@map("house_contacts")
}

model HouseEvent {
  id          Int            @id @default(autoincrement()) @db.UnsignedInt
  houseId     Int            @map("house_id") @db.UnsignedInt
  type        HouseEventType @default(other)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  startsAt    DateTime       @map("starts_at") @db.DateTime(3)
  endsAt      DateTime?      @map("ends_at") @db.DateTime(3)
  location    String?        @db.VarChar(500)
  isCancelled Boolean        @default(false) @map("is_cancelled")

  house House @relation(fields: [houseId], references: [id])

  @@index([houseId, isCancelled, startsAt, id])
  @@map("house_events")
}

model HouseInvitation {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  houseId   Int       @map("house_id") @db.UnsignedInt
  code      String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)

  house House @relation(fields: [houseId], references: [id])

  @@index([houseId])
  @@map("house_invitations")
}

model HouseMembership {
  id               Int                   @id @default(autoincrement()) @db.UnsignedInt
  userId           Int                   @map("user_id") @db.UnsignedInt
  houseId          Int                   @map("house_id") @db.UnsignedInt
  status           HouseMembershipStatus @default(approved)
  lastLeftAt       DateTime?             @map("last_left_at") @db.DateTime(3)
  revocationReason String?               @map("revocation_reason") @db.Text
  displayName      String                @map("display_name") @db.VarChar(255)
  notifyMeetings   Boolean               @default(false) @map("notify_meetings")
  notifyRequests   Boolean               @default(false) @map("notify_requests")

  user       User                  @relation(fields: [userId], references: [id])
  house      House                 @relation(fields: [houseId], references: [id])
  roles      HouseMemberRole[]
  apartments ApartmentMembership[]

  @@unique([userId, houseId])
  @@unique([id, houseId])
  @@map("house_memberships")
}

model HouseMemberRole {
  membershipId Int       @map("membership_id") @db.UnsignedInt
  role         HouseRole

  membership HouseMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, role])
  @@map("house_member_roles")
}

model Apartment {
  id      Int    @id @default(autoincrement()) @db.UnsignedInt
  houseId Int    @map("house_id") @db.UnsignedInt
  number  String @db.VarChar(32)

  house       House                 @relation(fields: [houseId], references: [id])
  memberships ApartmentMembership[]

  @@unique([houseId, number])
  @@unique([id, houseId])
  @@map("apartments")
}

model ApartmentMembership {
  membershipId       Int                         @map("membership_id") @db.UnsignedInt
  apartmentId        Int                         @map("apartment_id") @db.UnsignedInt
  houseId            Int                         @map("house_id") @db.UnsignedInt
  relationship       ApartmentRelationship
  verificationStatus ApartmentVerificationStatus @default(pending) @map("verification_status")

  membership HouseMembership @relation(fields: [membershipId, houseId], references: [id, houseId])
  apartment  Apartment       @relation(fields: [apartmentId, houseId], references: [id, houseId])

  @@id([membershipId, apartmentId])
  @@map("apartment_memberships")
}

model HouseJoinRequest {
  id              Int                    @id @default(autoincrement()) @db.UnsignedInt
  userId          Int                    @map("user_id") @db.UnsignedInt
  houseId         Int                    @map("house_id") @db.UnsignedInt
  apartmentNumber String                 @map("apartment_number") @db.VarChar(32)
  displayName     String                 @map("display_name") @db.VarChar(255)
  relationship    ApartmentRelationship
  status          HouseJoinRequestStatus @default(pending)
  createdAt       DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  rejectionReason String?                @map("rejection_reason") @db.Text
  notifyMeetings  Boolean                @default(false) @map("notify_meetings")
  notifyRequests  Boolean                @default(false) @map("notify_requests")

  user  User  @relation(fields: [userId], references: [id])
  house House @relation(fields: [houseId], references: [id])

  @@index([userId, status])
  @@index([houseId, status])
  @@map("house_join_requests")
}

model Meeting {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  houseId     Int           @map("house_id") @db.UnsignedInt
  authorId    Int?          @map("author_id") @db.UnsignedInt
  title       String        @db.VarChar(255)
  description String?       @db.Text
  format      MeetingFormat @default(absentee)
  location    String?       @db.VarChar(500)
  startsAt    DateTime      @map("starts_at") @db.DateTime(3)
  endsAt      DateTime      @map("ends_at") @db.DateTime(3)
  isCancelled Boolean       @default(false) @map("is_cancelled")

  house          House                  @relation(fields: [houseId], references: [id])
  author         User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  questions      MeetingQuestion[]
  participations MeetingParticipation[]

  @@index([houseId, isCancelled, endsAt, id])
  @@map("meetings")
}

model MeetingQuestion {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  meetingId Int    @map("meeting_id") @db.UnsignedInt
  title     String @db.Text
  sortOrder Int    @default(0) @map("sort_order") @db.UnsignedInt

  meeting Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes   MeetingVote[]

  @@index([meetingId, sortOrder, id])
  @@map("meeting_questions")
}

model MeetingVote {
  questionId Int               @map("question_id") @db.UnsignedInt
  userId     Int               @map("user_id") @db.UnsignedInt
  choice     MeetingVoteChoice

  question MeetingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
  @@map("meeting_votes")
}

model MeetingParticipation {
  meetingId  Int     @map("meeting_id") @db.UnsignedInt
  userId     Int     @map("user_id") @db.UnsignedInt
  willAttend Boolean @map("will_attend")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([meetingId, willAttend])
  @@map("meeting_participations")
}
